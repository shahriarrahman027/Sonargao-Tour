# Supabase Free Project Credentials (Client-safe anon key only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Only for local development mode when Supabase is not connected yet.
# NEVER put real production student IDs or admin passwords in client-side env vars.
# In production, student ID hashes and admin password hash live strictly in Supabase DB.
VITE_APP_ENV=development
